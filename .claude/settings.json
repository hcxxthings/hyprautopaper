{
  "permissions": {
    "allow": [
      "Read",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(nix flake check *)",
      "Bash(nix eval *)",
      "Bash(nixos-rebuild build *)",
      "Bash(nixos-rebuild dry-build *)",
      "Bash(nix fmt *)",
      "Bash(nixfmt *)"
    ],
    "ask": [
      "Bash(nixos-rebuild switch *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git branch *)"
    ],
    "deny": [
      "Bash(home-manager switch *)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(nix-collect-garbage *)",
      "Bash(git push *)",
      "Bash(git push --force *)",
      "Bash(git reset --hard *)",
      "Read(~/.ssh/**)",
      "Read(~/.config/sops/**)",
      "Read(**/*.age)"
    ]
  }
}
